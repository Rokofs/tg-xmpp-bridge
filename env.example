# Скопируйте этот файл в .env и заполните своими значениями.
# Загружать .env можно через `export $(cat .env | xargs)` перед запуском
# или через пакет python-dotenv (см. README.md).

# --- Telegram ---
# Токен бота, полученный от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAабвгдЕЁЖЗ...

# ID чата/группы, которую мостим (число, может быть отрицательным для групп).
# ОСТАВЬТЕ ПУСТЫМ при первом запуске: запустите bridge.py только с
# TELEGRAM_BOT_TOKEN, напишите боту в нужном чате команду /chatid —
# он пришлёт число, которое нужно вписать сюда. После этого
# перезапустите бота.
TELEGRAM_CHAT_ID=

# --- XMPP ---
# JID и пароль ОТДЕЛЬНОГО аккаунта, который будет ботом-мостом.
# Зарегистрировать можно, например, на xmpp.jp или monocles.eu.
XMPP_JID=bridgebot@xmpp.jp
XMPP_PASSWORD=супер-секретный-пароль

# С кем мостим сообщения:
#  - обычный контакт: XMPP_PEER_JID=friend@monocles.eu, XMPP_IS_MUC=false
#  - групповой чат (MUC): XMPP_PEER_JID=room@conference.xmpp.jp, XMPP_IS_MUC=true
XMPP_PEER_JID=friend@monocles.eu
XMPP_IS_MUC=false
XMPP_MUC_NICK=TelegramBridge
# Пароль комнаты (MUC), если она защищена паролем — оставьте пустым,
# если пароля нет:
XMPP_MUC_PASSWORD=

# Если бот падает с telegram.error.TimedOut / ConnectTimeout, хотя
# интернет и VPN работают — почти наверняка проблема в IPv6 (VPN
# туннелирует только IPv4). Раскомментируйте строку ниже, чтобы
# заставить бота использовать только IPv4:
# TELEGRAM_FORCE_IPV4=true
